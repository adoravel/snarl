{
	"name": "@404/aether",
	"description": "a minimal islands architecture implementation for snarl",
	"version": "1.0.1",
	"license": "MPL-2.0",
	"exports": {
		".": "./src/mod.ts",
		"./jsx-runtime": "./src/jsx-runtime.ts",
		"./client": "./src/client/mod.ts",
		"./client/jsx-runtime": "./src/client/jsx-runtime.ts",
		"./client/jsx-dev-runtime": "./src/client/jsx-runtime.ts",
		"./reactivity": "./src/reactivity/mod.ts",
		"./server": "./src/server/mod.ts"
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@404/aether",
		"lib": ["deno.ns", "dom", "dom.iterable"]
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any"]
		}
	},
	"imports": {
		"@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
		"esbuild": "npm:esbuild@^0.28.2",
		"meriyah": "npm:meriyah@^7.3.1"
	}
}
