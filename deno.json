{
	"name": "@july/snarl",
	"description": "a minimal web framework for deno",
	"version": "2.1.0",
	"license": "MPL-2.0",
	"workspace": ["./packages/*", "./examples/*"],
	"exports": {
		".": "./src/mod.ts",
		"./jsx-runtime": "./src/jsx-runtime.ts",
		"./jsx-dev-runtime": "./src/jsx-runtime.ts",
		"./verbosity": "./src/verbosity.ts"
	},
	"tasks": {
		"bench": "deno task --cwd=bench start",
		"bench:gen": "deno task --cwd=bench generate",
		"test": "deno test --allow-read --allow-env --allow-net --allow-write --allow-run"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/async": "jsr:@std/async@^1.5.0",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/fmt": "jsr:@std/fmt@^1.0.10",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/media-types": "jsr:@std/media-types@^1.1.0",
		"@std/path": "jsr:@std/path@^1.1.6",
		"@std/http": "jsr:@std/http@^1.1.3",
		"@std/streams": "jsr:@std/streams@^1.1.2",
		"happy-dom": "npm:happy-dom@^20.14.5"
	},
	"exclude": ["./bench"],
	"fmt": {
		"useTabs": true,
		"semiColons": true,
		"lineWidth": 100
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["deno.ns", "dom", "dom.iterable"]
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any"]
		}
	}
}
